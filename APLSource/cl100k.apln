:Namespace cl100k
    ⍝ cl100k_base Tokeniser for Dyalog APL
    ⍝ Implementation similar to OpenAI's tiktoken
    ⎕IO←0
    ⎕ML←1

    tokens←⍬

    lToken←tokens∘⍳


    'base64' ⎕CY 'dfns'

    ∇ Load path;lines;_
        lines←⊃⎕NGET path 1
        _←{tokens,←⊂∊base64⊃' '(≠⊆⊢)⍵}¨lines
        lToken←tokens∘⍳
    ∇

    s←{
        0=≢⍵:⍬
        p←'''(?i:[sdmt]|ll|ve|re)|[^\r\n\p{L}\p{N}]?+\p{L}++|\p{N}{1,3}+| ?[^\s\p{L}\p{N}]++[\r\n]*+|\s++$|\s*[\r\n]|\s+(?!\S)|\s'
        p ⎕S {⍵.Match}⍠('Mode' 'M')⊢⍵
    }

    mrp←{ ⍝ Find Minimum rank pair
        0=≢⍵:⍬
        t←{lToken⊂∊⍵}¨⍵
        ~∨/100256>t:⍬
        ⊃⍵[⊃⍋t]

        ⍝idx←(∊¨⍵)⍳⊂(tokens,⊂⍬)⊃⍨⌊/{lToken⊂∊⍵}¨⍵
        ⍝⊃(⍵,⊂⍬)[idx]
    }

    mp←{ ⍝ merge pairs
        0=≢⍺:⍵
        ∊¨(,¨⍺)(⊢⊂⍨(~∘⌽⍷⍥⌽))⍵
    }

    BPE←{ ⍝ Byte Pair Encoding Algthm
        1≥≢⍵:,⊂⍵
        {
            p←2(,⍥⊂)/⍵
            b←mrp p
            0=≢b:⍵
            b mp ⍵
        }⍣≡,¨⍵
    }

    Encode←{
        {lToken⊂∊⍵}¨{⊃,/,¨⊆¨⍵}{BPE 'UTF-8' ⎕UCS⍵}¨s ∊⍵
    }

    Decode←{
        'UTF-8' ⎕UCS ∊tokens[⍵]
    }
:EndNamespace
